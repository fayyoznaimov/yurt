# Собранные данные и курсы — пересобираются командой python run.py
data/
# Заказы и покупатели (телефоны, имена), состояние канала, исследования конкурентов — только локально,
# никогда в git (репозиторий публичный). Строки явные, даже если data/ выше когда-нибудь уберут.
data/orders/
data/channel_state.json
data/analysis/
# свой хост фото: карта токен → адрес магазина и кэш готовых фото (img_map.py, img_api.py)
data/img_map.json
data/img_cache/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal

# Сайт: файлы товаров и фото генерирует run.py
site/products.js
site/products.json
# каталог частями (catalog_files.py) — тоже генерирует run.py
site/data/
site/img/*
# логотипы брендов (brands.py) — в git, их публикует deploy.py
!site/img/brands/
# закупочные цены, маржа и ссылки на магазины — никогда не публиковать
site/products-admin.js
site/admin/*
!site/admin/admin.js

# Python
__pycache__/
.venv/
*.log

# Локальные настройки редактора / Claude
.claude/

# рабочая копия gh-pages в GitHub Actions
_pages/

# генерируется из content.json (content.py / deploy.py)
site/content.js
site/brands.js
