# Турецкие магазины + сборка + публикация: каждые 3 часа (по Ташкенту 00:05, 03:05, 06:05 … 21:05).
[Unit]
Description=yurt: обновление каталога каждые 3 часа

[Timer]
OnCalendar=*-*-* 00/3:05:00 Asia/Tashkent
RandomizedDelaySec=10min
Persistent=true
Unit=yurt-job@update.service

[Install]
WantedBy=timers.target
