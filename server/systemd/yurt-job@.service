# Одно задание каталога: yurt-job@yoox / @fx / @cleanup / @update (server/yurt-run.sh <задание>).
# Турция — свои службы с другими сроками: yurt-turkey-akinon, yurt-trendyol-pdp, yurt-trendyol-listing.
# yurt-job@update (всё одним run.py) — только вручную при выключенных таймерах Турции; таймера у него нет.
# @USER@ и @APP@ подставляет server/setup.sh.
[Unit]
Description=yurt: задание %i
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=@USER@
Group=@USER@
WorkingDirectory=@APP@
EnvironmentFile=/etc/yurt/yurt.env
ExecStart=/usr/bin/env bash @APP@/server/yurt-run.sh %i
TimeoutStartSec=3h
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
