# То же, что systemd-таймеры, — если systemd нет или удобнее cron. Установить: crontab -u yurt server/crontab.example
# (пути — как ставит server/setup.sh; поменяйте, если ставили иначе). Время — по CRON_TZ; его понимает cronie
# (RHEL/Fedora), а cron в Debian/Ubuntu — нет: там время по поясу сервера (timedatectl set-timezone Asia/Tashkent).
# Задания Турции — по отдельности (у каждого свой замок; ход, пока прошлый ещё идёт, пропускается). YOOX сервер не
# собирает: только импорт файлов кнопки из «входящих».
CRON_TZ=Asia/Tashkent
SHELL=/bin/bash
# переменные из /etc/yurt/yurt.env подхватываются через set -a
5 * * * *     set -a; . /etc/yurt/yurt.env; set +a; /opt/yurt/app/server/yurt-run.sh turkey-akinon    >/dev/null 2>&1
20 * * * *    set -a; . /etc/yurt/yurt.env; set +a; /opt/yurt/app/server/yurt-run.sh trendyol-pdp     >/dev/null 2>&1
10 1 * * *    set -a; . /etc/yurt/yurt.env; set +a; /opt/yurt/app/server/yurt-run.sh trendyol-listing >/dev/null 2>&1
*/15 * * * *  set -a; . /etc/yurt/yurt.env; set +a; /opt/yurt/app/server/yurt-run.sh yoox             >/dev/null 2>&1
0 9 * * *     set -a; . /etc/yurt/yurt.env; set +a; /opt/yurt/app/server/yurt-run.sh fx               >/dev/null 2>&1
30 4 * * 0    set -a; . /etc/yurt/yurt.env; set +a; /opt/yurt/app/server/yurt-run.sh cleanup          >/dev/null 2>&1
# свой хост фото: прогрев первых фото турецких магазинов (YOOX — никогда); сама служба img_api.py — не из cron
40 3 * * *    set -a; . /etc/yurt/yurt.env; set +a; cd /opt/yurt/app && "${YURT_PYTHON:-python3}" img_api.py --prewarm --limit "${IMG_PREWARM_LIMIT:-3000}" >/dev/null 2>&1
