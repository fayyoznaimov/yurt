# /etc/yurt/yurt.env — настройки каталога на сервере (права 640, владелец root:yurt). Создаёт server/setup.sh.
# Здесь могут быть секреты (токен Telegram) — файл не в git и не показывайте его никому.

# Часовой пояс: дата курса ЦБ, время в «Обновлено …» на сайте
TZ=Asia/Tashkent
# Python из виртуального окружения (ставит setup.sh)
YURT_PYTHON=/opt/yurt/venv/bin/python
# «Входящие» для файлов YOOX: сюда push_yoox.py с вашего компьютера кладёт yoox_*.json
YURT_YOOX_FOLDER=/opt/yurt/inbox
# 1 — перед заданием update брать свежий код/config.json/index.html из GitHub (git pull)
YURT_AUTO_PULL=1
# 1 — публиковать сайт (deploy.py → ветка gh-pages); 0 — только собирать
YURT_DEPLOY=1

# Уведомления в Telegram (необязательно; пусто — без уведомлений). См. notify.py.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
YURT_NAME=yurt-server
# турецкий источник не обновлялся столько часов — сообщить
YURT_STALE_HOURS=30

# Заказы с сайта (order_api.py, служба yurt-orders). Тот же бот, что и для уведомлений, или отдельный.
# Чат для заказов: ваш id, id группы (-100…) или канала, где бот — участник. Пусто — берётся TELEGRAM_CHAT_ID.
TELEGRAM_ORDERS_CHAT_ID=
# С каких сайтов принимать заказы (через запятую, без / на конце). Свой домен — допишите сюда.
ORDER_ALLOWED_ORIGINS=https://fayyoznaimov.github.io
# Порт на 127.0.0.1; наружу по HTTPS его выставляет Caddy или Cloudflare Tunnel (см. README «Заказы с сайта»)
ORDER_API_PORT=8787
ORDER_API_BIND=127.0.0.1
# Не больше ORDER_RATE_LIMIT заказов с одного IP за ORDER_RATE_WINDOW секунд
ORDER_RATE_LIMIT=5
ORDER_RATE_WINDOW=600
