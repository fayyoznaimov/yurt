# /etc/yurt/yurt.env — настройки каталога на сервере (права 640, владелец root:yurt). Создаёт server/setup.sh.
# Здесь могут быть секреты (токен Telegram) — файл не в git и не показывайте его никому.

# Часовой пояс: дата курса ЦБ, время в «Обновлено …» на сайте
TZ=Asia/Tashkent
# Python из виртуального окружения (ставит setup.sh)
YURT_PYTHON=/opt/yurt/venv/bin/python
# «Входящие» для файлов YOOX: сюда push_yoox.py с вашего компьютера кладёт yoox_*.json
YURT_YOOX_FOLDER=/opt/yurt/inbox
# 1 — перед заданием update брать свежий код/config.json/index.html из GitHub (git pull)
YURT_AUTO_PULL=1
# 1 — публиковать сайт (deploy.py → ветка gh-pages); 0 — только собирать
YURT_DEPLOY=1

# Уведомления в Telegram (необязательно; пусто — без уведомлений). См. notify.py.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
YURT_NAME=yurt-server
# турецкий источник не обновлялся столько часов — сообщить
YURT_STALE_HOURS=30

# Заказы с сайта (order_api.py, служба yurt-orders). Тот же бот, что и для уведомлений, или отдельный.
# Чат для заказов: ваш id, id группы (-100…) или канала, где бот — участник. Пусто — берётся TELEGRAM_CHAT_ID.
TELEGRAM_ORDERS_CHAT_ID=
# С каких сайтов принимать заказы (через запятую, без / на конце). Свой домен — допишите сюда.
ORDER_ALLOWED_ORIGINS=https://fayyoznaimov.github.io
# Порт на 127.0.0.1; наружу по HTTPS его выставляет Caddy или Cloudflare Tunnel (см. README «Заказы с сайта»)
ORDER_API_PORT=8787
ORDER_API_BIND=127.0.0.1
# Не больше ORDER_RATE_LIMIT заказов с одного IP за ORDER_RATE_WINDOW секунд
ORDER_RATE_LIMIT=5
ORDER_RATE_WINDOW=600

# Бот заказов (tg_bot.py) работает ВНУТРИ службы yurt-orders — отдельной службы и вебхука нет. Он единственный
# читает обновления Telegram для TELEGRAM_BOT_TOKEN: не запускайте другой бот/скрипт с getUpdates на этом токене.
# Кто может нажимать кнопки статусов заказа: ваш Telegram id (и помощников) через запятую. Узнать свой id —
# написать боту @userinfobot. Пусто — админ владелец чата заказов (личный чат) или любой участник группы заказов.
# Лучше заполнить всегда (особенно при CHANNEL_ENABLED=1 — иначе order_api.py --check и channel.py --status предупредят).
TELEGRAM_ADMIN_IDS=
# Адрес магазина для кнопки «Открыть магазин» (Mini App) — только https://. После правки один раз:
#   sudo -u yurt /opt/yurt/venv/bin/python /opt/yurt/app/tg_bot.py --set-menu
SHOP_URL=https://fayyoznaimov.github.io/yurt/
# Ник бота без @ (как в @BotFather): ссылки «Получать статус в Telegram» t.me/<бот>?start=o_<номер>_<подпись>.
# Подпись ставит сервер (токеном бота) и отдаёт сайту в ответе на заказ (bot_url) — без неё бот заказ не привяжет.
# Ссылку для заказа вручную: python tg_bot.py --link YR-…  Тот же ник впишите в site/content.json → orders_bot_username.
BOT_USERNAME=
# Ваш ник для фразы «напишите нам в Telegram @…» в сообщениях бота. Пусто — берётся из site/content.json
# (orders_telegram_username, иначе contacts.telegram).
SELLER_TELEGRAM=
# База заказов (SQLite, только на сервере; копия раз в сутки в data/orders/backup/, хранится N дней)
# ORDERS_DB_PATH=/opt/yurt/app/data/orders/orders.sqlite
ORDER_BACKUP_KEEP_DAYS=30
# 0 — не перепроверять наличие у Trendyol / Pierre Cardin / Cacharel после заказа (по умолчанию проверяет)
ORDER_VERIFY=1

# Канал Telegram (channel.py; таймеры yurt-channel@propose / yurt-channel@sync). Эти же переменные читает
# обработчик кнопок «Опубликовать/Пропустить» внутри yurt-orders — после правки перезапустите yurt-orders.
# 1 — публиковать по-настоящему. 0 — всё пробно: python channel.py --plan / --propose только печатают, в сеть
# ничего не уходит. Включайте, когда неделю посмотрели пробные подборки и бот — администратор канала.
CHANNEL_ENABLED=0
# Канал: @ник публичного канала или числовой id закрытого (-100…). Бот должен быть его администратором
# с правами «Публикация сообщений» и «Редактирование сообщений».
CHANNEL_ID=
# Куда присылать подборку на проверку (кнопки «Опубликовать» / «Пропустить»): ваш личный Telegram id.
# Пусто — первый id из TELEGRAM_ADMIN_IDS. Если TELEGRAM_ADMIN_IDS пуст, этот id (если он личный, > 0)
# тоже может нажимать кнопки канала.
CHANNEL_REVIEW_CHAT_ID=
# Сколько постов присылать на проверку за раз (таймер yurt-channel@propose, 09:00 по Ташкенту)
CHANNEL_PROPOSE_N=8

# Воронка (funnel.py; таймеры yurt-funnel@report / @digest / @carts / @followup — примеры, сами не включаются).
# Плагины бота внутри yurt-orders: channel (кнопки канала) и funnel (анкета «Подобрать вещи моего размера»,
# /settings, /report). Пусто — по умолчанию «channel,funnel». После правки перезапустите yurt-orders.
TG_BOT_PLUGINS=channel,funnel
# Не больше EVENT_RATE_LIMIT запросов /api/event (и столько же /api/cart) с одного IP за EVENT_RATE_WINDOW секунд
EVENT_RATE_LIMIT=120
EVENT_RATE_WINDOW=600
# Первая подборка после анкеты: новинки за столько последних дней
FUNNEL_DIGEST_FIRST_DAYS=3
# 0 — подборки без альбома фото (только список с кнопками)
FUNNEL_DIGEST_PHOTOS=1
# Напоминать о корзине через столько часов; корзины старше FUNNEL_CART_MAX_DAYS дней не трогаем
FUNNEL_CART_HOURS=24
FUNNEL_CART_MAX_DAYS=7
# «Всё подошло?» — через столько дней после статуса «выдан»
FUNNEL_FOLLOWUP_DAYS=7
# Тексты бота (подборки, корзина, «Всё подошло?», бонус за друга referral_bonus) — server/order_messages.json
